{#
/**
 * @file
 * Theme override for main view template.
 *
 * Identique au template de Stable9, à une exception près : la zone « aucun
 * résultat » ({{ empty }}) est enveloppée dans un conteneur `.view-empty` afin
 * qu'elle puisse être stylée et enrichie côté client (voir list-filters.js /
 * list-filters.css). Stable9 rend `{{ empty }}` sans wrapper, ce qui ne laisse
 * rien à cibler.
 *
 * @see template_preprocess_views_view()
 * @see core/themes/stable9/templates/views/views-view.html.twig
 */
#}
{%
  set classes = [
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title }}
  {{ title_suffix }}

  {% if header %}
    <header>
      {{ header }}
    </header>
  {% endif %}

  {{ exposed }}
  {{ attachment_before }}

  {% if rows -%}
    {{ rows }}
  {% elseif empty -%}
    <div class="view-empty">
      {{ empty }}
    </div>
  {% endif %}
  {{ pager }}

  {{ attachment_after }}
  {{ more }}

  {% if footer %}
    <footer>
      {{ footer }}
    </footer>
  {% endif %}

  {{ feed_icons }}
</div>
